# Which project these credentials point at. REQUIRED.
# Every seed/wipe script and the whole test suite refuse to run unless this
# reads staging or local — they write with the service-role key, which bypasses
# RLS and every owner-tier lock. Set `production` for the live project and those
# scripts stay blocked. Missing/unknown value = refused (fails closed).
SUPABASE_ENV=staging

# Supabase project credentials — copy to .env.local and fill in.
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only (employee account management) — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Owner login used by the test suites (npm test)
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
