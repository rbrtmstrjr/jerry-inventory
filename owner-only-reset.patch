diff --git a/scripts/test-owner-reset.mjs b/scripts/test-owner-reset.mjs
new file mode 100644
index 0000000..d2baa8f
--- /dev/null
+++ b/scripts/test-owner-reset.mjs
@@ -0,0 +1,152 @@
+/**
+ * Owner-only password reset — the things that can silently regress.
+ *
+ * 1. STATIC: the domain rule is actually wired into all four credential write
+ *    paths, and the PUBLIC reset action still cannot become an oracle. Zod
+ *    schemas and server actions live inside Next server code, which a Node
+ *    script cannot invoke — so this asserts over the SOURCE, the same way
+ *    test-definer-guards.mjs asserts over migration SQL. It fails the moment
+ *    someone edits a schema and drops the refine, or adds a return branch that
+ *    reports failure. (The RULE's own behaviour — which domains it accepts and
+ *    refuses — is asserted directly in test-lib-unit.mjs and
+ *    test-admin-accounts.mjs, against the exported predicate.)
+ *
+ * 2. LIVE: every non-owner account — active OR deactivated — has an address
+ *    that cannot receive mail. This is the assertion that catches an account
+ *    created through a path this design did not anticipate. The owner is the
+ *    deliberate exception and is asserted to STAY reachable — he is the one
+ *    account nobody can rescue.
+ *
+ * Run: node scripts/test-owner-reset.mjs
+ */
+import { readFileSync } from "node:fs";
+import { owner, admin, check, section, summary } from "./_harness.mjs";
+import { isNonRoutableEmail } from "../lib/login-email.ts";
+
+const read = (p) => readFileSync(new URL(`../${p}`, import.meta.url), "utf8");
+
+section("The domain rule is wired into every credential write path");
+{
+  const shops = read("app/(owner)/shops/actions.ts");
+  const settings = read("app/(owner)/settings/actions.ts");
+
+  check("shops/actions.ts imports the rule", shops.includes("isLoginEmailDomain"));
+  check("settings/actions.ts imports the rule", settings.includes("isLoginEmailDomain"));
+
+  // At least one refine per schema: employee + credentials, createAdmin +
+  // updateCreds. Deliberately `>=`, not `===`: a fifth correctly-guarded
+  // credential write path is the hardening this test exists to encourage, and
+  // an exact count would turn the suite red for doing the right thing.
+  const shopRefines = (shops.match(/refine\(isLoginEmailDomain/g) ?? []).length;
+  const settingsRefines = (settings.match(/refine\(isLoginEmailDomain/g) ?? []).length;
+  check(`shops: >=2 schemas guarded (found ${shopRefines})`, shopRefines >= 2, `${shopRefines}`);
+  check(`settings: >=2 schemas guarded (found ${settingsRefines})`, settingsRefines >= 2, `${settingsRefines}`);
+}
+
+section("The PUBLIC reset action cannot become an oracle");
+{
+  const action = read("app/(auth)/login/actions.ts");
+
+  // Scope to the public action's own body. The file also holds an owner-gated
+  // twin that is DELIBERATELY truthful (it runs behind requirePrimaryOwner(),
+  // where there is no address left to conceal), so a whole-file assertion would
+  // now be asserting the opposite of what that action is for.
+  const pubStart = action.indexOf("export async function requestOwnerPasswordReset(");
+  check("public action still exists", pubStart >= 0);
+  const nextExport = action.indexOf("export async function", pubStart + 1);
+  const pub = nextExport > 0 ? action.slice(pubStart, nextExport) : action.slice(pubStart);
+
+  // EVERY return in that body is the shared constant — not "at least N of
+  // them". A new branch returning anything else is the regression this catches,
+  // whatever it returns and however many exits the body ends up with.
+  const doneReturns = (pub.match(/return\s+DONE;/g) ?? []).length;
+  const allReturns = (pub.match(/\breturn\b[^;]*;/g) ?? []).length;
+  check(
+    `every exit in the public action returns DONE (${doneReturns}/${allReturns})`,
+    doneReturns >= 4 && doneReturns === allReturns,
+    `${doneReturns} of ${allReturns}`
+  );
+  check("no literal { ok: ... } returns in the public action", !/return\s*\{\s*ok:/.test(pub));
+  check(
+    "sends to the stored address, not the submitted one",
+    action.includes("resetPasswordForEmail(ownerEmail")
+  );
+  check("owner is resolved by role, not by trusting input", action.includes('.eq("role", "owner")'));
+}
+
+section("The owner-gated twin is gated, and cannot be aimed elsewhere");
+{
+  const action = read("app/(auth)/login/actions.ts");
+  const authStart = action.indexOf("export async function requestOwnerPasswordResetAuthenticated(");
+  check("authenticated action exists", authStart >= 0);
+  const authed = authStart >= 0 ? action.slice(authStart) : "";
+
+  check("it checks the tier itself", /isPrimaryOwner\(\)/.test(authed));
+  check("isPrimaryOwner is imported from lib/auth", /import \{[^}]*isPrimaryOwner[^}]*\} from "@\/lib\/auth"/.test(action));
+  // No parameter: the address is derived server-side, so neither a compromised
+  // client nor the owner himself can point a reset link at another mailbox.
+  check(
+    "takes no email parameter",
+    /requestOwnerPasswordResetAuthenticated\(\s*\)\s*:/.test(authed)
+  );
+  check("it reports real failures", /return \{ ok: false, error/.test(authed));
+}
+
+section("No client-side reset path survives");
+{
+  const dialog = read("app/(auth)/login/login-form.tsx");
+  const card = read("app/(owner)/settings/account-section.tsx");
+  check("login dialog no longer calls resetPasswordForEmail", !dialog.includes("resetPasswordForEmail"));
+  check("login dialog goes through the server action", dialog.includes("requestOwnerPasswordReset"));
+  check("settings card no longer calls resetPasswordForEmail", !card.includes("resetPasswordForEmail"));
+  check(
+    "settings card goes through the owner-gated server action",
+    card.includes("requestOwnerPasswordResetAuthenticated")
+  );
+}
+
+section("Live: every non-owner login is non-routable");
+{
+  const { data: profiles, error } = await owner
+    .from("profiles").select("id, role, active").is("deleted_at", null);
+  check("read profiles", !error, error?.message);
+
+  const PAGE_SIZE = 1000;
+  const { data: page } = await admin.auth.admin.listUsers({ page: 1, perPage: PAGE_SIZE });
+  const users = page?.users ?? [];
+  // A full page means there may be more accounts this check never looked at,
+  // and a permanent invariant that passes while blind is worse than no check.
+  check(
+    `auth listing is complete (${users.length} < perPage ${PAGE_SIZE})`,
+    users.length < PAGE_SIZE,
+    `${users.length} users returned — add pagination, this check is blind past ${PAGE_SIZE}`
+  );
+  const emailById = new Map(users.map((u) => [u.id, u.email ?? ""]));
+
+  // INACTIVE accounts count too. updateEmployee (app/(owner)/shops/actions.ts)
+  // can flip `active` back to true and its schema carries no email field, so
+  // reactivation never re-runs the domain check — a deactivated account parked
+  // on a routable address is a live hole one toggle away.
+  const offenders = (profiles ?? [])
+    .filter((p) => p.role !== "owner")
+    .map((p) => ({ role: p.role, active: p.active, email: emailById.get(p.id) ?? "" }))
+    .filter((p) => p.email && !isNonRoutableEmail(p.email));
+
+  check(
+    `no non-owner account can receive mail, active or not (${offenders.length} offender(s))`,
+    offenders.length === 0,
+    offenders.map((o) => `${o.role}${o.active ? "" : "/inactive"}:${o.email}`).join(", ")
+  );
+
+  // The owner is the deliberate exception and MUST stay reachable — his is the
+  // only account with no human fallback.
+  const ownerProfile = (profiles ?? []).find((p) => p.role === "owner" && p.active);
+  const ownerEmail = ownerProfile ? emailById.get(ownerProfile.id) ?? "" : "";
+  check(
+    "owner still has a routable address",
+    !!ownerEmail && !isNonRoutableEmail(ownerEmail),
+    ownerEmail || "(none)"
+  );
+}
+
+summary();
