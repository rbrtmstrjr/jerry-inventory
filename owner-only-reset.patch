@@ -0,0 +1,200 @@
+"use server";
+
+import { headers } from "next/headers";
+import { createClient as createSupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+
+import { isPrimaryOwner } from "@/lib/auth";
+import { createAdminClient } from "@/lib/supabase/admin";
+
+/**
+ * Owner-only password reset.
+ *
+ * WHY THIS EXISTS: Gerry mints and can change every shop and admin credential,
+ * so email-based self-service reset gives those accounts no capability the
+ * system lacks — only attack surface. Compromise a branch's shared inbox and
+ * you have that branch's login. This narrows the reset path to the one account
+ * nobody else can rescue.
+ *
+ * WHY THE SERVICE ROLE WITH NO SIGNED-IN CALLER: lib/supabase/admin.ts carries
+ * the rule "every caller must verify the current user is the owner BEFORE
+ * touching this client". The public action cannot — being locked out is the
+ * entire premise. It is a deliberate exception, and it is safe ONLY because
+ * that function is a sealed box: one string in, one constant out, and its sole
+ * side effect is Supabase mailing the owner's own stored address.
+ *
+ * TWO ACTIONS, ON PURPOSE — one silent, one truthful:
+ *
+ *   requestOwnerPasswordReset            PUBLIC / UNAUTHENTICATED (the login
+ *                                        page). Returns the same value on
+ *                                        every path. Anything else is an
+ *                                        oracle for the owner's address.
+ *
+ *   requestOwnerPasswordResetAuthenticated
+ *                                        OWNER-GATED (Settings → Account,
+ *                                        behind requirePrimaryOwner()). The
+ *                                        caller has already proved he is the
+ *                                        owner and the address is his own, so
+ *                                        there is no secret left to protect —
+ *                                        and hiding a rate-limit error from
+ *                                        him would cost him the only signal
+ *                                        that the mail never went out.
+ *
+ * Both share resolveOwnerEmail() + sendOwnerReset() below so the two can never
+ * drift into disagreeing about who the owner is or where the mail goes.
+ *
+ * KNOWN, ACCEPTED LIMITATION — the timing side-channel on the public action is
+ * REAL and is NOT throttled. On a MISS this never calls /auth/v1/recover, so
+ * Supabase's recovery rate limiter never engages: an attacker can probe as fast
+ * as our own server answers. Nor is the tell subtle — a match performs a whole
+ * SMTP send, hundreds of milliseconds slower than a miss. Do not write that the
+ * platform protects this; it does not.
+ *
+ * It is accepted anyway. What leaks is a single email address that is already
+ * guessable, and the only way to flatten it is to fire a decoy recovery request
+ * on every miss — which would pour mail through the same shared free-tier
+ * mailer the owner's own recovery depends on, on demand, from an unauthenticated
+ * endpoint. That is a worse hole than the one it closes. The mitigation that
+ * actually matters is operational: put the owner's mailbox on a domain he
+ * controls and turn 2FA on there (spec §7).
+ */
+
+const schema = z.object({ email: z.string().trim().min(1).max(200) });
+
+/* ── shared internals — neither action may reimplement these ─────────────── */
+
+/**
+ * The owner's STORED address, or null when there isn't one.
+ *
+ * Never derived from caller input: the owner is resolved by role, and the
+ * address comes off his auth record. ORDER BY id so that if a second owner row
+ * ever exists, which one wins is deterministic rather than whatever the planner
+ * returned that day.
+ */
+async function resolveOwnerEmail(): Promise<string | null> {
+  const admin = createAdminClient();
+
+  const { data: ownerProfile } = await admin
+    .from("profiles")
+    .select("id")
+    .eq("role", "owner")
+    .eq("active", true)
+    .is("deleted_at", null)
+    .order("id")
+    .limit(1)
+    .maybeSingle();
+  if (!ownerProfile) return null;
+
+  const { data: ownerUser } = await admin.auth.admin.getUserById(ownerProfile.id);
+  const ownerEmail = ownerUser?.user?.email?.trim() ?? "";
+  return ownerEmail || null;
+}
+
+/**
+ * Mail the recovery link to `ownerEmail`. Returns null on success, or a
+ * human-readable reason on failure — the CALLER decides whether that reason is
+ * safe to hand back. Always logs, whoever is asking.
+ */
+async function sendOwnerReset(ownerEmail: string): Promise<string | null> {
+  // Origin from the request, not an env var, so preview deploys keep working.
+  // Supabase's redirect allowlist is the real guard against a spoofed Host.
+  const h = await headers();
+  const host = h.get("host");
+  if (!host) return "Could not work out this site's address.";
+  // Never interpolate the raw header — it is attacker-supplied. Only the two
+  // schemes we actually serve are legal, and https is the default.
+  const proto = h.get("x-forwarded-proto") === "http" ? "http" : "https";
+  const origin = `${proto}://${host}`;
+
+  // A bare anon client: no cookies, no session, nothing to leak. Sends to the
+  // STORED address — never a caller-supplied string.
+  const anon = createSupabaseClient(
+    process.env.NEXT_PUBLIC_SUPABASE_URL!,
+    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
+    { auth: { persistSession: false, autoRefreshToken: false } }
+  );
+
+  const { error } = await anon.auth.resetPasswordForEmail(ownerEmail, {
+    redirectTo: `${origin}/auth/callback?next=/auth/reset`,
+  });
+  if (!error) return null;
+  console.error("[owner-reset] send failed:", error.code ?? error.message);
+  return error.message || "Sending the reset email failed.";
+}
+
+/* ── 1. PUBLIC — the login page's "Forgot password?" ──────────────────────── */
+
+export type OwnerResetResult = { ok: true };
+
+/** The one and only return value of the PUBLIC action. Never construct another. */
+const DONE: OwnerResetResult = { ok: true };
+
+/**
+ * >>> INVARIANT: every path returns the SAME value. <<<
+ *
+ * The moment this returns different data, shapes, or errors depending on the
+ * input, it becomes an oracle that confirms the owner's email address to anyone
+ * who can POST to it — and anyone can, this is the signed-out login page. Do
+ * not add a branch that reports failure. If you need a truthful answer, you are
+ * looking for the authenticated twin below.
+ */
+export async function requestOwnerPasswordReset(
+  input: unknown
+): Promise<OwnerResetResult> {
+  try {
+    const parsed = schema.safeParse(input);
+    if (!parsed.success) return DONE;
+    const submitted = parsed.data.email.trim().toLowerCase();
+
+    const ownerEmail = await resolveOwnerEmail();
+    if (!ownerEmail) return DONE;
+    if (ownerEmail.toLowerCase() !== submitted) return DONE;
+
+    // Logged inside the helper, deliberately not returned: surfacing a send
+    // failure here would confirm the submitted address matched.
+    await sendOwnerReset(ownerEmail);
+  } catch (e) {
+    console.error("[owner-reset] unexpected:", e);
+  }
+  return DONE;
+}
+
+/* ── 2. OWNER-GATED — Settings → Account ─────────────────────────────────── */
+
+export type OwnerResetAuthedResult = { ok: boolean; error?: string };
+
+/**
+ * The same send, told honestly.
+ *
+ * Reachable only from Settings → Account, which requirePrimaryOwner() already
+ * gates; this re-checks the tier itself rather than trusting that. The anti-
+ * oracle rule above does NOT apply here: the caller IS the owner and the
+ * address IS his own, so there is nothing left to conceal — while staying
+ * silent would leave him staring at "sent" when Supabase rate-limited the mail.
+ *
+ * Takes NO email parameter on purpose. The address is derived server-side from
+ * the owner record, so this cannot be aimed at somebody else's mailbox even by
+ * the owner himself.
+ */
+export async function requestOwnerPasswordResetAuthenticated(): Promise<OwnerResetAuthedResult> {
+  try {
+    if (!(await isPrimaryOwner())) {
+      return { ok: false, error: "Only the owner can do that" };
+    }
+
+    const ownerEmail = await resolveOwnerEmail();
+    if (!ownerEmail) {
+      return { ok: false, error: "No owner account with a sign-in email was found." };
+    }
+
+    const failure = await sendOwnerReset(ownerEmail);
+    if (failure) return { ok: false, error: failure };
+    return { ok: true };
+  } catch (e) {
+    console.error("[owner-reset:authed] unexpected:", e);
+    return {
+      ok: false,
+      error: e instanceof Error ? e.message : "Sending the reset email failed.",
+    };
+  }
+}
